generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Area {
  id               String            @id @default(uuid())
  name             String
  description      String?
  shortCode        String?
  shiftMode        Int               @default(3)
  parentAreaId     String?
  headUserId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parentArea       Area?             @relation("ParentChildArea", fields: [parentAreaId], references: [id], onDelete: SetNull)
  childAreas       Area[]            @relation("ParentChildArea")
  headUser         User?             @relation("AreaHeadUser", fields: [headUserId], references: [id], onDelete: SetNull)
  audits           Audit[]
  bhpHazardReports BhpHazardReport[]
  documents        Document[]
  faultReports     FaultReport[]
  kaizens          Kaizen[]
  machines         Machine[]
  qualityReports   QualityReport[]
  responsibleUsers User[]            @relation("UserResponsibleArea")
}

model Machine {
  id               String            @id @default(uuid())
  name             String
  description      String?
  shortCode        String?
  areaId           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  audits           Audit[]
  bhpHazardReports BhpHazardReport[]
  documents        Document[]
  faultReports     FaultReport[]
  kaizens          Kaizen[]
  area             Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  qualityReports   QualityReport[]

  @@index([areaId])
}

model Audit {
  id           String                @id @default(uuid())
  title        String
  areaId       String
  machineId    String?
  status       String                @default("DRAFT")
  auditTypeId  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  auditType    AuditType?            @relation(fields: [auditTypeId], references: [id])
  machine      Machine?              @relation(fields: [machineId], references: [id], onDelete: Restrict)
  area         Area                  @relation(fields: [areaId], references: [id])
  answers      AuditQuestionAnswer[]
  observations Observation[]

  @@index([status])
  @@index([areaId])
  @@index([auditTypeId])
  @@index([createdAt])
}

model AuditType {
  id          String              @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  audits      Audit[]
  questions   AuditTypeQuestion[]
}

model Observation {
  id              String                 @id @default(uuid())
  auditId         String
  description     String
  aiSuggestion    String?
  photoUrl        String?
  severity        String?                @default("MODERATE")
  dueDate         DateTime?
  isFixed         Boolean                @default(false)
  fixPhotoUrl     String?
  fixedBy         String?
  fixedAt         DateTime?
  operatorComment String?
  assignedToId    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  audit           Audit                  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  assignedTo      User?                  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  extensions      ObservationExtension[]

  @@index([auditId])
  @@index([assignedToId])
  @@index([isFixed])
  @@index([createdAt])
}

model ObservationExtension {
  id              String      @id @default(uuid())
  observationId   String
  previousDueDate DateTime?
  newDueDate      DateTime
  reason          String
  requestedBy     String
  createdAt       DateTime    @default(now())
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
}

model Document {
  id        String   @id @default(uuid())
  title     String
  category  String
  url       String
  areaId    String?
  machineId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([areaId])
}

model Kaizen {
  id             String    @id @default(uuid())
  title          String
  description    String
  benefits       String?
  submittedBy    String
  status         String    @default("PENDING")
  committeeNote  String?
  photoUrl       String?
  pointsAwarded  Int?      @default(0)
  pointsCategory String?
  isPaidOut      Boolean   @default(false)
  paidOutAt      DateTime?
  payoutDocNum   String?
  areaId         String?
  machineId      String?
  assignedToId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  assignedTo     User?     @relation("KaizenAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  machine        Machine?  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  area           Area?     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([areaId])
  @@index([submittedBy])
  @@index([isPaidOut])
  @@index([createdAt])
}

model KaizenPayoutRequest {
  id           String    @id @default(uuid())
  docNumber    String    @unique
  userName     String
  userLogin    String?
  bankAccount  String?
  kaizenIds    String
  kaizenTitles String?
  totalPoints  Int       @default(0)
  totalAmount  Float     @default(0)
  rewardType   String    @default("Premia finansowa z programu Kaizen")
  notes        String?
  status       String    @default("PENDING")
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([userLogin])
}

model Role {
  id                 String   @id @default(uuid())
  name               String   @unique
  description        String?
  isSystem           Boolean  @default(false)
  canCreateAudit     Boolean  @default(false)
  canCompleteAudit   Boolean  @default(false)
  canDeleteAudit     Boolean  @default(false)
  canManageStructure Boolean  @default(false)
  canManageUsers     Boolean  @default(false)
  canManageTypes     Boolean  @default(false)
  canManageKaizen    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
}

model User {
  id                          String             @id @default(uuid())
  login                       String             @unique
  name                        String
  email                       String?
  passwordHash                String
  role                        String             @default("OPERATOR")
  roleId                      String?
  responsibleAreaId           String?
  notifyBhp                   Boolean            @default(false)
  notifyQuality               Boolean            @default(false)
  notifyFaults                Boolean            @default(false)
  notifyKaizen                Boolean            @default(false)
  notifyAudits                Boolean            @default(false)
  isKaizenCommittee           Boolean            @default(false)
  bhpTrainingDueDate          DateTime?
  dismissedBhpNoticeThreshold Int?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  assignedBhpHazardReports    BhpHazardReport[]
  createdBugReports           BugReport[]
  sentBugMessages             BugReportMessage[]
  assignedFaultReports        FaultReport[]
  approvedTickets             HelpDeskTicket[]   @relation("ApprovedTickets")
  createdTickets              HelpDeskTicket[]   @relation("CreatedTickets")
  assignedTickets             HelpDeskTicket[]   @relation("AssignedTickets")
  assignedByTickets           HelpDeskTicket[]   @relation("AssignedByTickets")
  assignedKaizens             Kaizen[]           @relation("KaizenAssignedTo")
  assignedTasks               Observation[]
  assignedQualityReports      QualityReport[]
  responsibleArea             Area?              @relation("UserResponsibleArea", fields: [responsibleAreaId], references: [id])
  headOfAreas                 Area[]             @relation("AreaHeadUser")
  userRole                    Role?              @relation(fields: [roleId], references: [id])
  trainings                   UserTraining[]
  ticketHistoryChanges        HelpDeskTicketHistory[] @relation("TicketHistoryChanges")
  leaveBalances               LeaveBalance[]
  leaveRequests               LeaveRequest[]     @relation("UserLeaveRequests")
  approvedLeaves              LeaveRequest[]     @relation("ApproverLeaveRequests")

  @@index([role])
  @@index([responsibleAreaId])
}

model ObservationSeverity {
  id         String   @id @default(uuid())
  name       String
  color      String   @default("red")
  isPositive Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FaultReport {
  id              String    @id @default(uuid())
  title           String
  description     String
  severity        String    @default("MODERATE")
  status          String    @default("OPEN")
  reportedBy      String
  photoUrl        String?
  fixPhotoUrl     String?
  fixedBy         String?
  fixedAt         DateTime?
  operatorComment String?
  notifyEmails    String?
  dueDate         DateTime?
  areaId          String?
  machineId       String?
  assignedToId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  assignedTo      User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  machine         Machine?  @relation(fields: [machineId], references: [id])
  area            Area?     @relation(fields: [areaId], references: [id])

  @@index([status])
  @@index([areaId])
  @@index([machineId])
  @@index([assignedToId])
  @@index([createdAt])
}

model AuditTypeQuestion {
  id           String                @id @default(uuid())
  auditTypeId  String
  chapter      String                @default("Ogólne")
  code         String?
  questionText String
  guidance     String?
  isKnockOut   Boolean               @default(false)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  answers      AuditQuestionAnswer[]
  auditType    AuditType             @relation(fields: [auditTypeId], references: [id], onDelete: Cascade)

  @@index([auditTypeId])
}

model AuditQuestionAnswer {
  id         String            @id @default(uuid())
  auditId    String
  questionId String
  status     String            @default("PENDING")
  severity   String?
  comment    String?
  photoUrl   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  question   AuditTypeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  audit      Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, questionId])
  @@index([auditId])
  @@index([status])
}

model AccessLog {
  id              String    @id @default(uuid())
  userLogin       String
  userName        String
  entityType      String
  entityId        String
  entityTitle     String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  durationSec     Int       @default(0)
  ipAddress       String?
  actionCount     Int       @default(0)
  actionTypes     String    @default("")
  engagementLevel String    @default("SKIMMED")
  createdAt       DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([userLogin])
}

model KaizenScoringCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  minPoints   Int      @default(10)
  maxPoints   Int      @default(100)
  icon        String   @default("⚡")
  color       String   @default("amber")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KaizenGoal {
  id               String   @id @default(uuid())
  title            String
  targetPoints     Int      @default(500)
  period           String   @default("MONTHLY")
  rewardInfo       String?
  isScoringEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BhpHazardReport {
  id             String    @id @default(uuid())
  title          String
  description    String
  category       String    @default("NEAR_MISS")
  severity       String    @default("CRITICAL")
  status         String    @default("OPEN")
  reportedBy     String
  photoUrl       String?
  fixPhotoUrl    String?
  fixedBy        String?
  fixedAt        DateTime?
  actionTaken    String?
  notifyEmails   String?
  dueDate        DateTime?
  hazardCategory String?
  probability    Int?
  injurySeverity Int?
  riskScore      Int?
  riskLevel      String?
  areaId         String?
  machineId      String?
  assignedToId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  assignedTo     User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  machine        Machine?  @relation(fields: [machineId], references: [id])
  area           Area?     @relation(fields: [areaId], references: [id])

  @@index([status])
  @@index([areaId])
  @@index([assignedToId])
  @@index([createdAt])
}

model QualityReport {
  id               String    @id @default(uuid())
  title            String
  description      String
  category         String    @default("PRODUCT_DEFECT")
  severity         String    @default("CRITICAL")
  status           String    @default("OPEN")
  reportedBy       String
  batchNumber      String?
  quantityAffected String?
  photoUrl         String?
  fixPhotoUrl      String?
  fixedBy          String?
  fixedAt          DateTime?
  actionTaken      String?
  notifyEmails     String?
  dueDate          DateTime?
  areaId           String?
  machineId        String?
  assignedToId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  assignedTo       User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  machine          Machine?  @relation(fields: [machineId], references: [id])
  area             Area?     @relation(fields: [areaId], references: [id])

  @@index([status])
  @@index([areaId])
  @@index([assignedToId])
  @@index([createdAt])
}

model UserTrainingType {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  trainings   UserTraining[]
}

model UserTraining {
  id             String           @id @default(uuid())
  userId         String
  trainingTypeId String
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  trainingType   UserTrainingType @relation(fields: [trainingTypeId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trainingTypeId])
  @@index([userId])
  @@index([dueDate])
}

model BugReport {
  id             String             @id @default(uuid())
  title          String
  description    String
  category       String             @default("BUG")
  pageUrl        String?
  pageName       String?
  status         String             @default("OPEN")
  priority       String             @default("MEDIUM")
  photoUrl       String?
  createdById    String?
  unreadForUser  Boolean            @default(false)
  unreadForAdmin Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages       BugReportMessage[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model BugReportMessage {
  id            String    @id @default(uuid())
  bugReportId   String
  senderId      String
  message       String
  attachmentUrl String?
  createdAt     DateTime  @default(now())
  sender        User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  bugReport     BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  @@index([bugReportId])
  @@index([senderId])
}

model HelpDeskTicket {
  id                  String         @id @default(uuid())
  title               String
  description         String
  type                TicketType
  status              TicketStatus   @default(OPEN)
  priority            TicketPriority @default(MEDIUM)
  createdById         String
  isApprovedByManager Boolean?
  approvedById        String?
  managerComment      String?
  approvalDate        DateTime?
  estimatedDueDate    DateTime?
  resolutionNotes     String?
  closedAt            DateTime?
  // Assignment tracking
  assignedToId        String?
  assignedById        String?
  assignedAt          DateTime?
  // Help Desk read status
  readByHelpDesk      Boolean        @default(false)
  readByHelpDeskAt    DateTime?
  // Realization tracking
  realizationStartedAt DateTime?
  realizedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  approvedBy          User?          @relation("ApprovedTickets", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy           User           @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo          User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy          User?          @relation("AssignedByTickets", fields: [assignedById], references: [id], onDelete: SetNull)
  history             HelpDeskTicketHistory[] @relation("TicketHistory")
}

model HelpDeskTicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    HelpDeskTicket @relation("TicketHistory", fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy String
  user      User     @relation("TicketHistoryChanges", fields: [changedBy], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

enum TicketType {
  PROBLEM
  PURCHASE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model HelpDeskConfig {
  id                    String  @id @default("singleton")
  helpDeskEmail         String  @default("")
  replyToEmail          String  @default("")
  notifyOnNewTicket     Boolean @default(true)
  notifyOnStatusChange  Boolean @default(true)
  notifyOnAssignment    Boolean @default(true)
  isEmailEnabled        Boolean @default(false)
  updatedAt             DateTime @updatedAt

  @@map("helpdesk_config")
}

model LeaveBalance {
  id              String   @id @default(uuid())
  userId          String
  year            Int      @default(2026)
  totalDays       Int      @default(26)
  usedDays        Float    @default(0)
  availableDays   Float    @default(26)
  overdueDays     Float    @default(0)
  usedOverdueDays Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@index([year])
}

model LeaveRequest {
  id           String    @id @default(uuid())
  userId       String
  type         String    @default("WYPOCZYNKOWY")
  startDate    DateTime
  endDate      DateTime
  daysCount    Float     @default(1)
  reason       String?
  status       String    @default("PENDING")
  approverId   String?
  approverNote String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver     User?     @relation("ApproverLeaveRequests", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([startDate])
}
